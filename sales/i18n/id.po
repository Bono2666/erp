#. module: sales
msgid "Confirmation of Approval"
msgstr "Konfirmasi Persetujuan"

#. module: sales
msgid "Credit note can only be created from a customer invoice."
msgstr "Nota kredit hanya dapat dibuat dari faktur pelanggan."

#. module: sales
msgid "Credit note can only be created from a posted invoice."
msgstr "Nota kredit hanya dapat dibuat dari faktur yang sudah diposting."

#. module: sales
msgid "Done deliveries cannot be cancelled."
msgstr "Pengiriman yang selesai tidak dapat dibatalkan."

#. module: sales
msgid "Done deliveries cannot be deleted."
msgstr "Pengiriman yang selesai tidak dapat dihapus."

#. module: sales
msgid "Down payment fixed amount must be greater than zero."
msgstr "Jumlah tetap uang muka harus lebih besar dari nol."

#. module: sales
msgid "Down payment invoice cannot be created after a regular invoice already exists."
msgstr "Faktur uang muka tidak dapat dibuat setelah faktur reguler sudah ada."

#. module: sales
msgid "Down payment percentage must be greater than zero."
msgstr "Persentase uang muka harus lebih besar dari nol."

#. module: sales
msgid "Invoice can only be created from a confirmed sales order."
msgstr "Faktur hanya dapat dibuat dari pesanan penjualan yang sudah dikonfirmasi."

#. module: sales
msgid "Only cancelled or posted invoices can be reset to draft."
msgstr "Hanya faktur yang dibatalkan atau diposting yang dapat diatur ulang ke draf."

#. module: sales
msgid "Only draft deliveries can be validated."
msgstr "Hanya pengiriman draf yang dapat divalidasi."

#. module: sales
msgid "Only draft invoices can be confirmed."
msgstr "Hanya faktur draf yang dapat dikonfirmasi."

#. module: sales
msgid "Only draft payments can be confirmed."
msgstr "Hanya pembayaran draf yang dapat dikonfirmasi."

#. module: sales
msgid "Only posted invoices can be sent by email."
msgstr "Hanya faktur yang diposting yang dapat dikirim melalui email."

#. module: sales
msgid "Only quotations in 'Waiting Approval' state can be approved."
msgstr "Hanya penawaran dengan status 'Menunggu Persetujuan' yang dapat disetujui."

#. module: sales
msgid "Only quotations in 'Waiting Approval' state can be rejected."
msgstr "Hanya penawaran dengan status 'Menunggu Persetujuan' yang dapat ditolak."

#. module: sales
msgid "Only quotations in 'Waiting Approval' state can be returned."
msgstr "Hanya penawaran dengan status 'Menunggu Persetujuan' yang dapat dikembalikan."

#. module: sales
msgid "Only quotations in 'Waiting Approval' state can be revised."
msgstr "Hanya penawaran dengan status 'Menunggu Persetujuan' yang dapat direvisi."

#. module: sales
msgid "Only quotations/sales orders in 'Draft' state can be submitted for approval."
msgstr "Hanya penawaran/pesanan penjualan dengan status 'Draf' yang dapat diajukan untuk persetujuan."

#. module: sales
msgid "Pay"
msgstr "Bayar"

#. module: sales
msgid "Payment amount cannot exceed the amount due (%(due)s)."
msgstr "Jumlah pembayaran tidak boleh melebihi jumlah terutang (%(due)s)."

#. module: sales
msgid "Payment amount must be greater than zero."
msgstr "Jumlah pembayaran harus lebih besar dari nol."

#. module: sales
msgid "Payment can only be registered for posted invoices."
msgstr "Pembayaran hanya dapat didaftarkan untuk faktur yang sudah diposting."

#. module: sales
msgid "Please Provide Reject Reason"
msgstr "Mohon Berikan Alasan Penolakan"

#. module: sales
msgid "Please Provide Return Reason"
msgstr "Mohon Berikan Alasan Pengembalian"

#. module: sales
msgid "Please add at least one invoice line before confirming this invoice."
msgstr "Tambahkan minimal satu baris faktur sebelum mengonfirmasi faktur ini."

#. module: sales
msgid "Please add at least one order line before creating an invoice."
msgstr "Tambahkan minimal satu baris pesanan sebelum membuat faktur."

#. module: sales
msgid "Posted invoices cannot be cancelled."
msgstr "Faktur yang sudah diposting tidak dapat dibatalkan."

#. module: sales
msgid "Posted payments cannot be cancelled directly. Reset to draft first."
msgstr "Pembayaran yang sudah diposting tidak dapat dibatalkan langsung. Atur ulang ke draf terlebih dahulu."

#. module: sales
msgid "Quantiity On Hand"
