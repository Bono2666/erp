#. module: sales
#: model:mail.template,body_html:sales.email_template_sales_approval_request
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Arial', sans-serif;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Halo <strong>${ctx.get('approver_name')}</strong>,<br><br>\n"
"                        Mohon tinjau permintaan persetujuan untuk pesanan penjualan berikut:\n"
"                        <br><br>\n"
"                        <strong>Nomor Order:</strong> ${object.sales_code}<br>\n"
"                        <strong>Customer:</strong> ${object.customer_id.customer_name}<br>\n"
"                        <strong>Total Nilai:</strong> ${format_amount(object.total_amount, 'Rp')}<br>\n"
"                        <strong>Salesman:</strong> ${object.sales_name.name}<br>\n"
"                        <br>\n"
"                        Sistem mendeteksi adanya <strong>Diskon Khusus</strong> yang memerlukan otorisasi dari posisi Anda sebagai <em>${ctx.get('position')}</em>.\n"
"                        <br><br>\n"
"                        Silakan klik tombol di bawah ini untuk melihat detail dan memberikan keputusan:\n"
"                        <br><br>\n"
"                        <center>\n"
"                            <a href=\"/web#id=%24%7Bobject.id%7D&amp;model=sales.sales_order&amp;view_type=form\" style=\"background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 14px;\">\n"
"                            Lihat Pesanan Penjualan\n"
"                            </a>\n"
"                        </center>\n"
"                        <br><br>\n"
"                        Terima kasih.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sales
#: model:mail.template,body_html:sales.email_template_sales_invoice
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Yth. <strong><t t-out=\"object.customer_id.customer_name\"></t></strong>,<br><br>\n"
"                        Bersama email ini kami sampaikan invoice\n"
"                        <strong><t t-out=\"object.invoice_number\"></t></strong>\n"
"                        dengan total tagihan sebesar\n"
"                        <strong>Rp <t t-out=\"'{:,.0f}'.format(object.amount_total)\"></t></strong>.\n"
"                        <br><br>\n"
"                        Mohon segera melakukan pembayaran sesuai dengan termin yang telah disepakati.\n"
"                        <br><br>\n"
"                        Jika Anda memiliki pertanyaan, jangan ragu untuk menghubungi kami.\n"
"                        <br><br>\n"
"                        Hormat kami,<br>\n"
"                        <strong><t t-out=\"object.sales_name.name or ''\"></t></strong>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sales
#: model:mail.template,body_html:sales.email_template_compressor_quotation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Yth. <strong><t t-out=\"object.customer_id.customer_name\"></t></strong>,<br><br>\n"
"                        Terima kasih atas ketertarikan Anda terhadap produk kompresor kami.\n"
"                        Kami dengan senang hati mengirimkan penawaran harga <strong><t t-out=\"object.sales_code\"></t></strong> \n"
"                        dengan total nilai sebesar <strong><t t-out=\"object.env['res.lang']._lang_get('en_US').format('%d', object.total_amount, grouping=True)\"></t></strong>.\n"
"                        <br><br>\n"
"                        Detail spesifikasi teknis telah kami lampirkan dalam format PDF pada email ini.\n"
"                        <br><br>\n"
"                        Jika Anda memiliki pertanyaan lebih lanjut, jangan ragu untuk menghubungi kami.\n"
"                        <br><br>\n"
"                        Hormat kami,<br>\n"
"                        <strong><t t-out=\"object.sales_name.name\"></t></strong>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

