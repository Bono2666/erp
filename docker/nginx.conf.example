# Nginx reverse proxy for the ERP (Odoo 17) container.
# Copy to /etc/nginx/sites-available/erp, replace erp.example.com,
# then obtain a certificate: sudo certbot --nginx -d erp.example.com

upstream erp_http      { server 127.0.0.1:8017; }   # ODOO_HTTP_PORT
upstream erp_websocket { server 127.0.0.1:8072; }   # ODOO_GEVENT_PORT

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name erp.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name erp.example.com;

    # Managed by certbot
    ssl_certificate     /etc/letsencrypt/live/erp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.example.com/privkey.pem;

    client_max_body_size 50m;
    proxy_read_timeout   720s;
    proxy_connect_timeout 720s;
    proxy_send_timeout   720s;

    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP         $remote_addr;

    # Live updates (bus/chat) go to the gevent worker when ODOO_WORKERS > 0
    location /websocket {
        proxy_pass http://erp_websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        proxy_pass http://erp_http;
        proxy_redirect off;
    }

    gzip on;
    gzip_types text/css text/plain application/json application/javascript text/xml application/xml;
}
