          <span class="flex-grow-1 text-truncate mt-1" style="min-width: 150px; flex-shrink: 0; white-space: nowrap;">
            <field name="model_description"/>
          </span>
          <style>
            .o_control_panel {
              display: none !important;
            }
          </style>
        </header>
        <sheet>
          <div class="oe_title">
            <div class="row">
              <div class="col-md-6">
                <group>

                  <field name="country_id" string="ID Negara" readonly="not is_edit and id" placeholder="e.g. CTRY-001" default_focus="1"/>

                </group>
              </div>
              <div class="col-md-6">
                <group>

                  <field name="country_name" string="Nama Negara" options="{'line_breaks': False}" widget="text" placeholder="e.g. Indonesia" readonly="not is_edit and id"/>

                </group>
              </div>
            </div>
          </div>
        </sheet>
      </form>
      </field>
    </record>
    
