    <!-- general.home form view — Enterprise-style home screen -->
    <record id="general.home_view_form" model="ir.ui.view">
      <field name="name">general.home.view.form</field>
      <field name="model">general.home</field>
      <field name="arch" type="xml">
        <form string="Beranda" create="false" edit="false">
          <style>
            .o_control_panel {
              display: none !important;
            }
            .o_home_menu_background {
              background: #ffffff;
              min-height: 100vh;
              padding: 48px 0;
            }
            .home-menu-grid {
              display: grid !important;
              grid-template-columns: repeat(4, 1fr) !important;
              gap: 16px 8px !important;
              max-width: 420px !important;
              padding: 16px !important;
              margin: 0 auto !important;
              justify-items: center !important;
              align-items: start !important;
            }
            @media (min-width: 768px) {
              .home-menu-grid {
                grid-template-columns: repeat(6, 136.33px) !important;
                max-width: 817.98px !important;
                padding: 0 16px !important;
              }
            }
            button.home-menu-card,
            .o_form_view button.home-menu-card,
            .btn.home-menu-card {
              display: flex !important;
              flex-direction: column !important;
              align-items: center !important;
              justify-content: center !important;
              width: 100% !important;
              max-width: 90px !important;
              height: 110px !important;
              background: transparent !important;
              border: none !important;
              box-shadow: none !important;
              cursor: pointer !important;
              font-size: 13px !important;
              font-weight: 600 !important;
              color: #374151 !important;
              padding: 0 !important;
              margin: 0 auto !important;
              text-align: center !important;
              line-height: 1.3 !important;
            }
            button.home-menu-card:hover {
              box-shadow: none !important;
              border: none !important;
            }
            button.home-menu-card::before {
              content: '' !important;
              display: block !important;
              width: 64px !important;
              height: 64px !important;
              min-width: 64px !important;
              min-height: 64px !important;
              background-size: contain !important;
              background-repeat: no-repeat !important;
              background-position: center !important;
              margin: 0 auto 6px !important;
              border: 1px solid #dee2e6 !important;
              border-radius: 14px !important;
              pointer-events: none !important;
            }
            button.home-menu-card:hover::before {
              transform: scale(1.08) !important;
              border-color: #adb5bd !important;
            }
            button.home-menu-card span,
            button.home-menu-card .o_button_text {
              display: block !important;
              width: 100% !important;
              text-align: center !important;
              margin: 0 auto !important;
              white-space: normal !important;
              word-break: break-word !important;
            }
            button.home-menu-card:hover::before {
              transform: scale(1.08);
              border-color: #adb5bd;
            }
            button.home-card-hcm::before {
              background-image: url('/hcm/static/description/icon.png');
            }
            button.home-card-sales::before {
              background-image: url('/sales/static/description/icon.png');
            }
            button.home-card-config::before {
              background-image: url('/general/static/description/icon.png');
            }
          </style>
          <div class="o_home_menu_background">
            <field name="show_hcm" invisible="1"/>
            <field name="show_sales" invisible="1"/>
            <field name="show_configuration" invisible="1"/>
            <div class="home-menu-grid">
              <button name="action_open_hcm" type="object"
                      class="home-menu-card home-card-hcm"
                      string="HCM"
                      invisible="not show_hcm"/>
              <button name="action_open_sales" type="object"
                      class="home-menu-card home-card-sales"
                      string="Penjualan"
                      invisible="not show_sales"/>
              <button name="action_open_configuration" type="object"
                      class="home-menu-card home-card-config"
                      string="Konfigurasi"
                      invisible="not show_configuration"/>
            </div>
          </div>
        </form>
      </field>
    </record>

    <!-- my preferences form -->
    <record id="view_general_preferences_form" model="ir.ui.view">
        <field name="name">general.preferences.form</field>
