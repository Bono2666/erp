# Copy to .env and change every password before deploying.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-db-password
ODOO_ADMIN_PASSWORD=change-this-master-password
ODOO_DB_NAME=erp

# Fresh server only: modules installed when the database does not exist yet.
# Leave empty when restoring an existing database from a backup.
ODOO_INIT_MODULES=general,hcm,sales,user_management
# Languages activated on a fresh database. The first one becomes the admin language.
ODOO_LOAD_LANGUAGE=id_ID,en_US

# Workers: max (2 x vCPU) + 1. 0 = single process (development only).
# 2 vCPU / 4 GB RAM -> 3 workers. 4 vCPU / 8 GB RAM -> 6 workers.
ODOO_WORKERS=3
ODOO_MAX_CRON_THREADS=1
# Per-worker memory limits in bytes (640 MB / 768 MB).
ODOO_LIMIT_MEMORY_SOFT=671088640
ODOO_LIMIT_MEMORY_HARD=805306368

# Keep False in production unless you intentionally expose DB management.
ODOO_LIST_DB=False
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=info

# Host ports (bound to 127.0.0.1, put a reverse proxy in front).
ODOO_HTTP_PORT=8017
ODOO_GEVENT_PORT=8072
