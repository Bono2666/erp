POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-db-password
ODOO_ADMIN_PASSWORD=change-this-master-password

# Development: 0. Production: usually 2 x CPU + 1, adjusted for RAM.
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=1

# Keep False on production unless you intentionally expose DB management.
ODOO_LIST_DB=False
ODOO_PROXY_MODE=True
ODOO_LOG_LEVEL=info

ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
