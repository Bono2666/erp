        }
      </field>
    </record>
-->

    <!-- Top menu item -->
<!--
    <menuitem name="user_management" id="user_management.menu_root"/>
-->
    <!-- menu categories -->

    <menuitem name="Pengguna" id="user_management.custom_user_menu" parent="general.menu_general_master_data" sequence="1" action="user_management.custom_users_action"/>
    
    <!-- actions -->
<!--
    <menuitem name="List" id="user_management.menu_1_list" parent="user_management.menu_1"
              action="user_management.action_window"/>
